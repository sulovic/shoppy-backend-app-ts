generator nabavkeClient {
    provider = "prisma-client-js"
    output   = "../../../prisma_clients/nabavke/client"
}

datasource db {
    provider = "postgresql"
}

model Porudzbine {
    id              Int       @id @default(autoincrement())
    proFaktura      String
    dobavljac       String
    spediter        String?
    datumPorudzbine DateTime
    datumPolaska    DateTime?
    datumPrijema    DateTime?
    sadrzaj         Sadrzaj[]
    brojKontejnera  String?
    komentar        String?
    files           Json?
    status          Statusi
    zemlja          Zemlje

    @@index([zemlja, status])
}

model Sadrzaj {
    id           Int        @id @default(autoincrement())
    porudzbina   Porudzbine @relation(fields: [porudzbinaId], references: [id], onDelete: Cascade)
    porudzbinaId Int
    proizvod     Proizvodi  @relation(fields: [proizvodId], references: [id], onDelete: Restrict)
    proizvodId   Int
    kolicina     Int
    cena         Float

    @@unique([porudzbinaId, proizvodId])
    @@index([porudzbinaId])
    @@index([proizvodId])
}

model Proizvodi {
    id      Int       @id @default(autoincrement())
    naziv   String
    SKU     String    @unique
    sadrzaj Sadrzaj[]
}

enum Statusi {
    NACRT
    PROIZVODNJA
    TRANZIT
    PRIMLJENA
}

enum Zemlje {
    SRBIJA
    CRNA_GORA
}
