generator client {
  provider = "prisma-client-js"
  output   = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_ODSUSTVA_URL")
}

model EvidencijaOdsustva {
  id            Int          @id @default(autoincrement())
  user          String
  vrstaOdsustva VrsteOdsutva
  start         DateTime
  end           DateTime
  brojDana      Int
  odobreno      Boolean      @default(false)
  odobrioUser   String?

  @@index([user])
}

model DodeljenaOdsustva {
  id            Int          @id @default(autoincrement())
  user          String
  vrstaOdsustva VrsteOdsutva
  godina        Int
  brojDana      Int
  dodelioUser   String

  @@index([user, godina])
}

enum VrsteOdsutva {
  GODISNJI_ODMOR
  SLUZBENI_PUT_U_ZEMLJI
  SLUZBENI_PUT_U_INOSTRANSTVO
  PLACENO_ODSUSTVO
}
