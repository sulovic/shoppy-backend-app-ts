generator otpadClient {
  provider = "prisma-client-js"
  output   = "../../../prisma_clients/otpad/client"
}

datasource db {
  provider = "postgresql"
}

model JciPodaci {
  id           Int            @id @default(autoincrement())
  zemlja       Zemlja
  datum        DateTime
  operacija    Operacija
  brojJci      String         @unique
  files        Json?
  jciProizvodi JciProizvodi[]

  @@index([zemlja, operacija, brojJci])
}

model JciProizvodi {
  id          Int       @id @default(autoincrement())
  kolicina    Float
  proizvodId  Int
  jciPodaciId Int
  jci         JciPodaci @relation(fields: [jciPodaciId], references: [id], onDelete: Cascade)
  proizvod    Proizvodi @relation(fields: [proizvodId], references: [id])
}

model Proizvodi {
  id                 Int                  @id @default(autoincrement())
  proizvod           String
  JciProizvodi       JciProizvodi[]
  ProizvodMasaOtpada ProizvodMasaOtpada[]
}

model VrsteOtpada {
  id                 Int                  @id @default(autoincrement())
  vrstaOtpada        String
  ProizvodMasaOtpada ProizvodMasaOtpada[]
}

model ProizvodMasaOtpada {
  id            Int         @id @default(autoincrement())
  masa          Float
  proizvodId    Int
  vrstaOtpadaId Int
  Proizvod      Proizvodi   @relation(fields: [proizvodId], references: [id], onDelete: Cascade)
  VrstaOtpada   VrsteOtpada @relation(fields: [vrstaOtpadaId], references: [id])
}

enum Operacija {
  UVOZ
  IZVOZ
}

enum Zemlja {
  SRBIJA
  CRNA_GORA
}
