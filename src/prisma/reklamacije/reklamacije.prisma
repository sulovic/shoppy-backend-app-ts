// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_REKLAMACIJE_URL")
}

model Reklamacije {
  idReklamacije     Int               @id @default(autoincrement())
  brojReklamacije   String            @unique
  zemljaReklamacije ZemljaReklamacije
  datumPrijema      DateTime?
  odgovornaOsoba    String?
  imePrezime        String
  adresa            String?
  telefon           String
  email             String?
  datumKupovine     DateTime?
  brojRacuna        String?
  nazivProizvoda    String?
  opisReklamacije   String?
  datumOdgovora     DateTime?
  opisOdluke        String?
  komentar          String?
  smsSent           Boolean           @default(false)
  statusReklamacije StatusReklamacije
  files             Json?

  @@index([zemljaReklamacije, statusReklamacije])
}

enum StatusReklamacije {
  PRIJEM
  OBRADA
  OPRAVDANA
  NEOPRAVDANA
  DODATNI_ROK
}

enum ZemljaReklamacije {
  SRBIJA
  CRNA_GORA
}
